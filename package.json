{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "uni-app": {
    "scripts": {
      "app": {
        "title": "App（原生）",
        "env": {
          "UNI_PLATFORM": "app"
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/patch-uni-default-platform.mjs",
    "dev": "uni -p h5",
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5",
    "build": "uni build -p app",
    "build:app:mock": "uni build -p app --mode mock",
    "build:app:real": "uni build -p app --mode real",
    "build:demo:h5": "uni build -p h5 --mode mock",
    "build:demo:app": "uni build -p app --mode mock",
    "build:prod:h5": "node scripts/check-real-env.mjs && uni build -p h5 --mode real",
    "build:android:web": "node scripts/build-android-web.mjs",
    "build:android": "npm run build:android:web && cap sync android",
    "apk:debug": "npm run build:android && node scripts/build-apk.mjs debug",
    "apk:release": "npm run build:android && node scripts/build-apk.mjs release",
    "build:prod:app": "node scripts/check-real-env.mjs && uni build -p app --mode real",
    "build:all:mock": "npm run build:h5 -- --mode mock && npm run build:app:mock",
    "build:all:real": "npm run build:prod:h5 && npm run build:prod:app",
    "build:all:demo": "npm run build:demo:h5 && npm run build:demo:app",
    "build:all:prod": "npm run build:prod:h5 && npm run build:prod:app",
    "dev:app": "uni -p app",
    "start": "uni -p h5"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "6.0.3",
    "@capacitor/browser": "6.0.6",
    "@capacitor/core": "6.2.2",
    "@capacitor/ios": "6.2.2",
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "^3.0.0-5020620260917001",
    "@dcloudio/uni-cli-i18n": "2.0.2-5020620260917001",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@vue/compiler-sfc": "^3.4.21",
    "@vue/shared": "^3.4.21",
    "pinia": "2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^5.2.1",
    "postcss": "^8.5",
    "sass": "^1.77.8",
    "sass-embedded": "^1.104.1",
    "typescript": "5.7.3",
    "vite": "5.2.8"
  }
}
